<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnablePackageValidation>true</EnablePackageValidation>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

        <NativeRuntimeRoot Condition="'$(NativeRuntimeRoot)' == ''">$(MSBuildProjectDirectory)/../../artifacts/native</NativeRuntimeRoot>
        <PackageId>Darp.Tesseract.Native</PackageId>
        <Title>Darp Tesseract Native Bindings</Title>
        <Description>SWIG-generated .NET bindings for Tesseract Robotics with prebuilt native runtimes.</Description>
        <PackageTags>darp;robotics;tesseract;native;interop;swig</PackageTags>
        <Authors>rosslight GmbH</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/rosslight/Darp.Tesseract</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Darp.Geometry/Darp.Geometry.csproj" />
        <Compile Update="Generated/**/*.cs">
            <Nullable>disable</Nullable>
        </Compile>
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="/" />
        <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" Visible="false" PackagePath="/" />
        <None Include="../../native/tesseract/LICENSE*" Pack="true" Visible="false" PackagePath="licenses/upstream/tesseract/" />
        <None Include="../../native/boost_plugin_loader/LICENSE*" Pack="true" Visible="false" PackagePath="licenses/upstream/boost_plugin_loader/" />
        <None Include="../../native/opw_kinematics/LICENSE*" Pack="true" Visible="false" PackagePath="licenses/upstream/opw_kinematics/" />
        <None Include="../../artifacts/notices/**/*" Pack="true" Visible="false" PackagePath="licenses/" />
        <None Include="$(NativeRuntimeRoot)/**/*.*"
              Condition="Exists('$(NativeRuntimeRoot)')"
              Pack="true"
              Visible="false"
              PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)"
              TargetPath="%(Filename)%(Extension)"
              CopyToOutputDirectory="Always" />
    </ItemGroup>
</Project>
