<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

    <PackageId>Darp.Tesseract.Native</PackageId>
    <Title>Darp Tesseract Native Bindings</Title>
    <Description>SWIG-generated .NET bindings for Tesseract Robotics with prebuilt native runtimes.</Description>
    <PackageTags>darp;robotics;tesseract;native;interop;swig</PackageTags>
    <Authors>rosslight GmbH</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/rosslight/Darp.Tesseract.Native</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Generated/**/*.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Darp.Tesseract.Native.targets" Pack="true" PackagePath="buildTransitive/Darp.Tesseract.Native.targets" />
    <None Include="../../artifacts/native/**/*.*"
          Condition="Exists('../../artifacts/native')"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          TargetPath="%(Filename)%(Extension)"
          Visible="true" />
  </ItemGroup>
</Project>
