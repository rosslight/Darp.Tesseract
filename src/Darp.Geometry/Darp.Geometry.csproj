<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Authors>rosslight GmbH</Authors>
        <Description>Managed geometry types for Darp Tesseract bindings.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/rosslight/Darp.Tesseract</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="NumFlat" Version="1.3.5" />
      <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Tensor2/README.md" Pack="true" PackagePath="/README.md" />
      <Folder Include="NumFlat\" />
      <Folder Include="Tensor\" />
    </ItemGroup>

</Project>
