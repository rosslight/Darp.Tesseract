<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseLocalProjectReference Condition="'$(UseLocalProjectReference)' == ''">true</UseLocalProjectReference>
    <DarpTesseractNativeVersion Condition="'$(DarpTesseractNativeVersion)' == ''">$(Version)</DarpTesseractNativeVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalProjectReference)' == 'true'">
    <ProjectReference Include="../../src/Darp.Tesseract.Native/Darp.Tesseract.Native.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalProjectReference)' != 'true'">
    <PackageReference Include="Darp.Tesseract.Native" Version="$(DarpTesseractNativeVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>

